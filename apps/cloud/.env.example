# Cloud gateway (apps/cloud). Keys live ONLY here, never in apps/web.
# With nothing set, every provider is replaced by a deterministic stand-in ("mock mode").

PORT=8788
# RIKUY_AI_MODE=mock           # force stand-ins even if keys exist
# CORS_ORIGINS=https://tu-pwa.example
# CONFIAR_PROXY=1              # trust X-Forwarded-For (only behind a known proxy)
# TOPE_MENSUAL_USD=3           # monthly AI budget per school
# USO_LOG_PATH=./data/uso.jsonl  # metadata-only usage log
# CATALOGO_DIR=./content/practicas
# UGEL_TOKEN=                  # enables GET /agregados/ugel

# AI providers
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # VERIFY on your account
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts   # Rikuy voice; without it the web uses Web Speech
# META_API_KEY=
# META_API_BASE_URL=https://api.meta.ai/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2:3b

# Report delivery (/reportes/enviar)
# REPORTES_SECRETO=            # HMAC secret for opt-out links (set it: otherwise links die on restart)
# PUBLIC_URL=https://nube.example
# EMAIL_FROM="Rikuy <no-responder@example.com>"
# EMAIL_PROVIDER=resend        # resend | smtp | mock
# RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0                # 1 = implicit TLS (465)
# SMTP_USER=
# SMTP_PASS=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=informe_semanal
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
